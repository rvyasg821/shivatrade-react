NODE_ENV=production
# Application mode: "single" hides SaaS + dropped-HRM UI. "saas" restores it.
REACT_APP_MODE=single
REACT_APP_BASENAME="Amazon Edge"
 
REACT_APP_REST_API_URL_ENDPOINT=""
REACT_APP_REST_API_URL_PREFIX="/api/v1"
 
REACT_APP_BACKEND_REST_API_URL_PDF="" //${baseUrl}/assets
 
SKIP_PREFLIGHT_CHECK=true
FAST_REFRESH=true
GENERATE_SOURCEMAP=false
